<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/rc_8_white"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:foreground="@drawable/ripple_effect"
    android:padding="8dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/icon_apple" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:fontFamily="@font/inter_semi_bold"
        android:maxLines="2"
        android:textColor="@color/passio_gray900"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintEnd_toStartOf="@id/foodSelect"
        app:layout_constraintStart_toEndOf="@id/image"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Plain Muffin" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/servingSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/passio_gray500"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintEnd_toStartOf="@id/foodSelect"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/image"
        app:layout_constraintTop_toBottomOf="@id/name"
        tools:text="1 Muffin (57g)" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="image,servingSize" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrierBottom">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/calValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/passio_calories"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintBottom_toBottomOf="@id/servingSize"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintTop_toTopOf="@id/servingSize"
            tools:text="201" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/calUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/passio_gray500"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintBottom_toBottomOf="@id/servingSize"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintTop_toTopOf="@id/servingSize"
            tools:text="cal" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/carbsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/passio_carbs"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintBottom_toBottomOf="@id/servingSize"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintTop_toTopOf="@id/servingSize"
            tools:text="201" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/carbsUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/passio_gray500"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintBottom_toBottomOf="@id/servingSize"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintTop_toTopOf="@id/servingSize"
            tools:text="g" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/proteinValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/passio_protein"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintBottom_toBottomOf="@id/servingSize"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintTop_toTopOf="@id/servingSize"
            tools:text="201" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/proteinUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/passio_gray500"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintBottom_toBottomOf="@id/servingSize"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintTop_toTopOf="@id/servingSize"
            tools:text="g" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/fatValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/passio_fat"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintBottom_toBottomOf="@id/servingSize"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintTop_toTopOf="@id/servingSize"
            tools:text="201" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/fatUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/passio_gray500"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintBottom_toBottomOf="@id/servingSize"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintTop_toTopOf="@id/servingSize"
            tools:text="g" />

    </androidx.appcompat.widget.LinearLayoutCompat>


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/foodSelect"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/image"
        app:srcCompat="@drawable/radio_off" />

</androidx.constraintlayout.widget.ConstraintLayout>